# Unity-generated folders (rebuilt automatically when the project opens)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / editor files (regenerated by Unity or the IDE)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash and build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# FMOD for Unity (rules recommended by the FMOD Setup Wizard)
# Never ignore DLLs in the FMOD subfolder.
!/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# Log files can be ignored.
fmod_editor.log

# FMOD Studio project: commit .fspro, Metadata/, Assets/ and Build/ (banks);
# ignore per-user and temporary files.
/3DGameKitFMOD/.user/
/3DGameKitFMOD/.cache/
/3DGameKitFMOD/.unsaved/

# FMOD copies banks into StreamingAssets during a build; keep the folder itself out of git too.
/[Aa]ssets/StreamingAssets.meta

# FMOD Studio's built banks: rebuilt by each person (FMOD Studio > Build) after pulling, so teammates
# never conflict on binary bank files. (The instructor repo tracks the starter banks so zips include
# them; brand-new banks there need "git add -f".)
/3DGameKitFMOD/Build/
